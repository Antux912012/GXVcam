#version 450
// Vulkan 1.3 compute: 16x16 tile L1 Bayer align & Tukey/Gaussian noise-weighted burst merge.
// Preserves RGGB/BGGR CFA phase parity by snapping tile offsets to even Bayer coordinates.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, r16ui) uniform readonly uimage2D uRefBayer;
layout(binding = 1, r16ui) uniform readonly uimage2D uAltBayer;
layout(binding = 2, rg16f) uniform readonly image2D uMotionVectors;
layout(binding = 3, r16f) uniform image2D uAccumBayer;
layout(binding = 4, r16f) uniform image2D uWeightSum;

layout(push_constant) uniform MergePC {
    vec4 blackLevel;
    float whiteLevel;
    float noiseS;
    float noiseO;
    int isFirstFrame;
} pc;

float readNormalizedBayer(bool useRef, ivec2 coord, ivec2 dims) {
    ivec2 c = clamp(coord, ivec2(0), dims - ivec2(1));
    int bayerIdx = (c.y & 1) * 2 + (c.x & 1);
    float raw = useRef ? float(imageLoad(uRefBayer, c).r) : float(imageLoad(uAltBayer, c).r);
    return clamp((raw - pc.blackLevel[bayerIdx]) / max(pc.whiteLevel - pc.blackLevel[bayerIdx], 1.0), 0.0, 1.0);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(uRefBayer);
    if (gid.x >= dims.x || gid.y >= dims.y) return;

    float refVal = readNormalizedBayer(true, gid, dims);
    if (pc.isFirstFrame == 1) {
        imageStore(uAccumBayer, gid, vec4(refVal, 0.0, 0.0, 1.0));
        imageStore(uWeightSum, gid, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }

    ivec2 mvDims = imageSize(uMotionVectors);
    ivec2 tileCoord = clamp(gid / 16, ivec2(0), mvDims - ivec2(1));
    vec2 flow = imageLoad(uMotionVectors, tileCoord).rg;
    ivec2 alignedCoord = gid + ivec2(round(flow * 0.5)) * 2;
    float altVal = readNormalizedBayer(false, alignedCoord, dims);

    float diffSq = 0.0;
    for (int dy = -2; dy <= 2; dy += 2) {
        for (int dx = -2; dx <= 2; dx += 2) {
            float r = readNormalizedBayer(true, gid + ivec2(dx, dy), dims);
            float a = readNormalizedBayer(false, alignedCoord + ivec2(dx, dy), dims);
            float d = r - a;
            diffSq += d * d;
        }
    }
    diffSq /= 9.0;

    float sigmaSq = max(pc.noiseS * refVal + pc.noiseO, 1e-6);
    float weight = exp(-diffSq / (2.0 * sigmaSq));

    float prevAccum = imageLoad(uAccumBayer, gid).r;
    float prevWeight = imageLoad(uWeightSum, gid).r;

    imageStore(uAccumBayer, gid, vec4(prevAccum + altVal * weight, 0.0, 0.0, 1.0));
    imageStore(uWeightSum, gid, vec4(prevWeight + weight, 0.0, 0.0, 1.0));
}
